{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AIAgentService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "Model": "gpt-4o-mini",
    "MaxTokens": 2000,
    "Temperature": 0.3,
    "TimeoutSeconds": 30
  },
  "RateLimit": {
    "RequestsPerDay": 100,
    "RequestsPerMinute": 10
  }
}
