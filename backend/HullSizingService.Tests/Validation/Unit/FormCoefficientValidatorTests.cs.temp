using FluentAssertions;
using HullSizingService.Services.Validation;
using Xunit;

namespace HullSizingService.Tests.Validation.Unit;

/// <summary>
/// Unit tests for form coefficient validation logic.
///
/// Tests coefficient range validation and relationship checks in isolation.
/// </summary>
[Trait("Category", "Unit")]
public class FormCoefficientValidatorTests
{
    [Fact]
    [Trait("Category", "Unit")]
    public void ValidateCbRange_WithinRange_ReturnsValid()
    {
        // Arrange
        var cb = 0.65m;
        var vesselType = "general_cargo";

        // Act
        var result = FormCoefficientValidator.ValidateCbRange(cb, vesselType);

        // Assert
        result.IsValid.Should().BeTrue("Cb 0.65 should be within range [0.60, 0.70] for general cargo");
        result.Message.Should().Contain("within");
    }

    [Fact]
    [Trait("Category", "Unit")]
    public void ValidateCbRange_OutsideRange_ReturnsInvalid()
    {
        // Arrange
        var cb = 0.75m; // Outside general cargo range [0.60, 0.70]
        var vesselType = "general_cargo";

        // Act
        var result = FormCoefficientValidator.ValidateCbRange(cb, vesselType);

        // Assert
        result.IsValid.Should().BeFalse("Cb 0.75 outside expected range for general cargo");
        result.Message.Should().Contain("outside");
    }

    [Fact]
    [Trait("Category", "Unit")]
    public void ValidateCpRelationship_ValidRelationship_ReturnsValid()
    {
        // Arrange
        var cb = 0.65m;
        var cm = 0.98m;
        var cp = cb / cm; // Valid relationship

        // Act
        var result = FormCoefficientValidator.ValidateCpRelationship(cb, cp, cm);

        // Assert
        result.IsValid.Should().BeTrue("Cp = Cb/Cm should be valid");
        result.Relationship.Should().Be("Cp = Cb/Cm");
    }

    [Fact]
    [Trait("Category", "Unit")]
    public void ValidateCpRelationship_InvalidRelationship_ReturnsInvalid()
    {
        // Arrange
        var cb = 0.65m;
        var cm = 0.98m;
        var cp = 0.80m; // Wrong - should be ~0.663

        // Act
        var result = FormCoefficientValidator.ValidateCpRelationship(cb, cp, cm);

        // Assert
        result.IsValid.Should().BeFalse("Cp should equal Cb/Cm");
        result.DeviationPercent.Should().BePositive("Should have positive deviation");
    }

    [Fact]
    [Trait("Category", "Unit")]
    public void ValidateCmForFullForm_ValidCm_ReturnsValid()
    {
        // Arrange
        var cm = 0.99m; // Expected for full-form vessels

        // Act
        var result = FormCoefficientValidator.ValidateCmForFullForm(cm);

        // Assert
        result.IsValid.Should().BeTrue("Cm 0.99 is valid for full-form vessels");
    }

    [Fact]
    [Trait("Category", "Unit")]
    public void ValidateCmForFullForm_TooLow_ReturnsInvalid()
    {
        // Arrange
        var cm = 0.96m; // Below expected range [0.98, 1.00]

        // Act
        var result = FormCoefficientValidator.ValidateCmForFullForm(cm);

        // Assert
        result.IsValid.Should().BeFalse("Cm too low for full-form vessel");
    }
}

